<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Selenium Test Suite" parallel="classes" thread-count="4" data-provider-thread-count="4">

    <!-- Allure and framework listeners register through ServiceLoader, including -Dtest runs. -->

    <test name="Smoke Tests">
        <classes>
            <class name="com.hoanhoang.tests.SingleProductPurchaseTest"/>
            <class name="com.hoanhoang.tests.MultipleProductPurchaseTest"/>
            <class name="com.hoanhoang.tests.PaymentMethodPurchaseTest"/>
            <class name="com.hoanhoang.tests.ProductSortingTest"/>
            <class name="com.hoanhoang.tests.OrderHistoryTest"/>
            <class name="com.hoanhoang.tests.GuestCheckoutTest"/>
            <class name="com.hoanhoang.tests.CheckoutValidationTest"/>
            <class name="com.hoanhoang.tests.CartClearTest"/>
            <class name="com.hoanhoang.tests.CartQuantityTest"/>
            <class name="com.hoanhoang.tests.ProductReviewTest"/>
        </classes>
    </test>
</suite>
