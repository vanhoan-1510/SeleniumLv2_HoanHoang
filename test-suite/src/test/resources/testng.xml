<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Selenium Test Suite" parallel="methods" thread-count="4" data-provider-thread-count="4">

    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
        <listener class-name="com.hoanhoang.report.listener.TestListener"/>
        <listener class-name="com.hoanhoang.report.listener.AccountManagementListener"/>
    </listeners>

    <test name="Smoke Tests">
        <classes>
            <class name="com.hoanhoang.tests.TC01"/>
            <class name="com.hoanhoang.tests.TC02"/>
            <class name="com.hoanhoang.tests.TC03"/>
            <class name="com.hoanhoang.tests.TC04"/>
            <class name="com.hoanhoang.tests.TC05"/>
            <class name="com.hoanhoang.tests.TC06"/>
            <class name="com.hoanhoang.tests.TC07"/>
            <class name="com.hoanhoang.tests.TC08"/>
            <class name="com.hoanhoang.tests.TC09"/>
            <class name="com.hoanhoang.tests.TC10"/>
        </classes>
    </test>
</suite>